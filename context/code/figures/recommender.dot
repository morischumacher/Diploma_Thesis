digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.4, compound=true];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, fillcolor="#ffffff", color="#6b7280"];
  edge [fontname="Helvetica", fontsize=8, color="#6b7280", arrowsize=0.7];

  req [label="POST /recommendations\nprogramCode · plannedCourses · doneCourses · parkedCourses", fillcolor="#e0f2fe"];
  svc [label="RecommendationService.recommend\nreads profile: interests, career_direction, toggles\nreads catalogue: candidates(program_code)\nchecker_for(code, strict=False)", fillcolor="#fef3c7"];
  ctx [label="build_context → PlanContext\ninterests (lower-cased) · career direction · toggles\nplanned/done/parked codes · pool\ncandidates = pool minus planned, done, parked\nhistory = taken courses with their metadata", fillcolor="#ffffff"];
  req -> svc -> ctx;

  subgraph cluster_ch {
    label="enabled_channels(toggles): CHANNELS in claim order (a channel not mentioned is on)"; style="rounded,filled"; fillcolor="#f5f3ff"; color="#c4b5fd"; fontsize=10;
    c1 [label="1 interest  ★ 'Interest match'\nstated interests vs course skills / description /\npartial word overlap; weighted, ÷ #interests;\nscore clamped 0.4–1.0\n'Matches your interests: focuses on …'"];
    c2 [label="2 similarity  ≈ 'Content similarity'\ncurated similar_courses links on courses already\ntaken or planned, read backwards; score 0.85\n'similar to <course> (<evidence>)'"];
    c3 [label="3 sequence  → 'Sequence dependency'\ncurriculum soft_prereqs + prerequisites,\nresolved to catalogue codes; 0.9 if a planned\ncourse needs it first, 0.8 if it follows a done one"];
    c4 [label="4 completed  ✓ 'Based on completed'\nshare of the synthetic cohort who took it after\na done course; floor 50 %; share = score\n'<n>% of students who completed <done> also took this'"];
    c5 [label="5 internship  ▶ 'Internship lens'\ncareer-direction words vs skills (×2) and description;\n÷ #words; clamped 0.4–0.9\n'develops skills for <direction> (<matched>)'"];
    c6 [label="6 peer  👤 'Other students'\n10 nearest synthetic students by overlap; weighted\nshare, 0.4 + 0.5·share; no overlap → popularity\nfallback flagged cold_start"];
    c1 -> c2 -> c3 -> c4 -> c5 -> c6 [style=invis];
  }
  ctx -> c1 [lhead=cluster_ch, label="for each candidate (outer), each channel (inner)"];

  asm [label="Assembly.add — at most one entry per course\nfirst channel to claim a code wins the reason;\na base name already recommended or already in the plan\n(VO/VU/UE of one course) is suppressed\nrecord: id rec_<code>_<channel> · courseCode · courseName · type\nscore · evidence · ects · category · examSubject · courseType", fillcolor="#ffffff"];
  c6 -> asm [ltail=cluster_ch];
  sort [label="sort by score, descending"];
  asm -> sort;
  flt [label="filter_by_rules (rules.py)\nbaseline = checker.evaluate(plan)\nfor the top 100: try the candidate in lane 99 and in the\nearliest planned lane, every catalogue row of that code;\nkeep if any trial adds no new error and no new warning;\nchecker raises → candidate dropped; baseline raises → unfiltered\nstop at RESULT_LIMIT = 15", fillcolor="#fee2e2"];
  sort -> flt;
  out [label="{ok: true, recommendations: [...]}", fillcolor="#ecfdf5"];
  flt -> out;

  coh [label="peer.py cohort_for(program_code, pool)\n50 synthetic students · 5 tracks × 15 courses\nseeded by md5(program_code) → deterministic\nmemoised, at most 4 programmes (LRU)", fillcolor="#fff7ed"];
  coh -> c4 [style=dashed]; coh -> c6 [style=dashed];
  meta [label="course metadata from course.attributes\n(content → skills/keywords · similar_courses)", fillcolor="#ecfdf5"];
  meta -> c1 [style=dashed]; meta -> c2 [style=dashed]; meta -> c5 [style=dashed];
  cur [label="app/curriculum/*.json ordering", fillcolor="#fee2e2"]; cur -> c3 [style=dashed];
}
