digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.9];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#f8fafc", color="#6b7280"];
  edge [fontname="Helvetica", fontsize=8, color="#374151", arrowsize=0.7];
  todo [label="todo\n(not in plan)\nwhite fill"]; parked [label="parked\nParking Stage, lane 0\nwhite fill, footer 'parked'"]; plan [label="in_plan\nsemester lane\ngrey fill, footer 'planned'"]; done [label="done\ngrey fill, grey border, opacity .8\nfooter 'done'"];
  todo -> plan [label="Add to plan → Semester Picker\n(or drop on a lane)"];
  todo -> parked [label="Add to plan → 'Parking Stage'\n(or drop on lane 0)"];
  parked -> plan [label="Move / drop on a lane"];
  plan -> parked [label="Move → 'Parking Stage'"];
  plan -> done [label="Mark done (course/doneChanged)"];
  done -> plan [label="Unmark"];
  plan -> todo [label="Remove"]; parked -> todo [label="Remove"]; done -> todo [label="Remove"];
  plan -> plan [label="drag to another lane\n(term parity checked;\nengine may roll back)"];
}
